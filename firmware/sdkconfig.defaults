# Match the stock image so our app drops into the existing flash layout.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# The pill is an ESP32-S0WD: single core, and the stock boot log says
# "cpu_start: Unicore app".
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000

CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# An OTA-installed build stays PENDING_VERIFY until it calls
# esp_ota_mark_app_valid_cancel_rollback(); app_main does that once the sensors,
# the advert and the HTTP server are up. A build that panics on the way reverts
# to the slot it came from, which is what makes a remote update survivable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Our partition table is byte-identical to the pill's (partitions.csv), and we
# only ever flash the app slot, so this exists to keep offsets honest.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# A Chrome POST carries Sec-Fetch-* and friends; the 512-byte default makes
# the settings form a 431 Header Fields Too Large.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536
